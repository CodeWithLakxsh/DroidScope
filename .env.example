# DroidScope configuration.
#
# Copy to .env and adjust. Every value has a safe default, so an empty file
# works for local use. Settings are read with the DROIDSCOPE_ prefix.

# --- general ----------------------------------------------------------------
# development | test | production
DROIDSCOPE_ENVIRONMENT=development
DROIDSCOPE_LOG_LEVEL=INFO
# Emit JSON logs; recommended for anything that ships logs somewhere.
DROIDSCOPE_LOG_JSON=false

# Where uploads, extracted artifacts, reports and the SQLite database live.
DROIDSCOPE_DATA_DIR=~/.droidscope

# --- database ---------------------------------------------------------------
# Default: SQLite inside DROIDSCOPE_DATA_DIR. Use PostgreSQL for a shared
# deployment or when several workers run concurrently.
# DROIDSCOPE_DATABASE_URL=postgresql+psycopg://droidscope:password@localhost:5432/droidscope

# --- API --------------------------------------------------------------------
DROIDSCOPE_API_PREFIX=/api/v1
DROIDSCOPE_CORS_ORIGINS=["http://localhost:5173"]

# Authentication is off for a single-user local install. Turn it on for any
# deployment reachable by more than one person, and set a long random key.
DROIDSCOPE_REQUIRE_AUTH=false
# DROIDSCOPE_API_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-32

# --- upload and archive limits ----------------------------------------------
DROIDSCOPE_MAX_UPLOAD_BYTES=536870912
DROIDSCOPE_MAX_UNCOMPRESSED_BYTES=4294967296
DROIDSCOPE_MAX_COMPRESSION_RATIO=200
DROIDSCOPE_MAX_ARCHIVE_ENTRIES=60000

# --- analysis ---------------------------------------------------------------
DROIDSCOPE_ANALYSIS_CONCURRENCY=2
DROIDSCOPE_ANALYZER_TIMEOUT_SECONDS=900
DROIDSCOPE_SCAN_TIMEOUT_SECONDS=3600
DROIDSCOPE_DECOMPILE_TIMEOUT_SECONDS=1200
DROIDSCOPE_GHIDRA_TIMEOUT_SECONDS=1800
DROIDSCOPE_ARTIFACT_RETENTION_DAYS=30
DROIDSCOPE_REUSE_IDENTICAL_SCANS=true

# --- tool locations ---------------------------------------------------------
# Leave unset to discover tools on PATH. These are read only at startup and
# are validated as existing executables; they cannot be set through the API.
# DROIDSCOPE_JADX_PATH=/opt/homebrew/bin/jadx
# DROIDSCOPE_APKTOOL_PATH=/opt/homebrew/bin/apktool
# DROIDSCOPE_ADB_PATH=/opt/homebrew/bin/adb
# DROIDSCOPE_FRIDA_PATH=/opt/homebrew/bin/frida
# DROIDSCOPE_MITMPROXY_PATH=/opt/homebrew/bin/mitmdump
# DROIDSCOPE_GHIDRA_HOME=/opt/homebrew/Cellar/ghidra/12.2
# DROIDSCOPE_ANDROID_SDK_ROOT=~/Library/Android/sdk
# Detection rule directory. Unset means discover it, which works from a
# checkout; a packaged or containerised install must set it explicitly.
# DROIDSCOPE_RULES_DIR=./rules
# DROIDSCOPE_YARA_RULES_DIR=./rules/yara

# --- dynamic analysis -------------------------------------------------------
# Off by default: a session installs and runs the uploaded application on a
# device. Only enable it against an isolated device you are authorised to use.
DROIDSCOPE_DYNAMIC_ANALYSIS_ENABLED=false
# Without this, only emulators can be selected.
DROIDSCOPE_DYNAMIC_ALLOW_PHYSICAL_DEVICES=false
DROIDSCOPE_DYNAMIC_SESSION_TIMEOUT_SECONDS=600

# --- reports ----------------------------------------------------------------
# Store and render a mask plus a fingerprint instead of a detected secret.
DROIDSCOPE_REDACT_SECRETS_IN_REPORTS=true
DROIDSCOPE_REPORT_ORGANISATION=DroidScope

# --- jobs -------------------------------------------------------------------
DROIDSCOPE_QUEUE_BACKEND=database
# DROIDSCOPE_REDIS_URL=redis://localhost:6379/0
DROIDSCOPE_WORKER_POLL_INTERVAL_SECONDS=1.0

# --- docker compose only ----------------------------------------------------
# POSTGRES_PASSWORD=change-me
